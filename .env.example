# ----------------------------------------------------------------------------
# ScholarsIQ200 environment variables
# Copy this file to `.env.local` and fill in the values.
# ----------------------------------------------------------------------------

# Groq API key — https://console.groq.com/keys  (free)
# Powers the multimodal LLM (text + vision).
GROQ_API_KEY=

# Upstash Vector — https://console.upstash.com/vector  (free tier)
# Create an index with an embedding model (e.g. mixedbread-large / bge) so the
# index can embed raw text passed via the `data` field. Then copy the REST URL
# and token below. Used for Retrieval-Augmented Generation.
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Tavily API key — https://app.tavily.com  (free tier)
# Powers the web-search tool. Optional: the app runs without it, the web-search
# tool just returns a friendly "not configured" message.
TAVILY_API_KEY=
